# Server Configuration
PORT=5000
NODE_ENV=development

# API Domain for Client (use localhost for local dev, or your deployed domain)
# Format: hostname:port (no http/https prefix)
EXPO_PUBLIC_DOMAIN=localhost:5000

# Database Configuration
# Example: postgresql://username:password@localhost:5432/kingdate
DATABASE_URL=postgresql://user:password@localhost:5432/kingdate

# Twilio Configuration (for SMS verification)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# Development Only (remove in production)
# For Replit compatibility (leave empty for local development)
REPLIT_DEV_DOMAIN=
REPLIT_DOMAINS=
