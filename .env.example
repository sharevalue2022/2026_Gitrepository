# Server Configuration
PORT=5000
NODE_ENV=development

# API Domain for Client (use localhost for local dev, or your deployed domain)
# Format: hostname:port (no http/https prefix)
EXPO_PUBLIC_DOMAIN=localhost:5000

# Database Configuration (OPTIONAL)
# If not set, will use in-memory SQLite (data will not persist between restarts)
# Example: postgresql://username:password@localhost:5432/kingdate
# DATABASE_URL=postgresql://user:password@localhost:5432/kingdate

# Solapi Configuration (for SMS verification)
# Get API credentials from https://console.solapi.com
SOLAPI_API_KEY=your_solapi_api_key
SOLAPI_API_SECRET=your_solapi_api_secret
SOLAPI_FROM_NUMBER=01012345678

# Development Only (remove in production)
# For Replit compatibility (leave empty for local development)
REPLIT_DEV_DOMAIN=
REPLIT_DOMAINS=
